<?xml version="1.0" encoding="UTF-8"?>
<!-- Browser build of Snake Brawl: TeaVM compiles the shared game code to JavaScript. Run web/build.sh. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.snakebrawl</groupId>
  <artifactId>snakebrawl-web</artifactId>
  <version>3.2</version>
  <packaging>jar</packaging>

  <properties>
    <teavm.version>0.14.1</teavm.version>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- build.sh assembles the shared game sources plus the web-only ones here -->
    <sourceDirectory>${project.build.directory}/src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <mainClass>com.snakebrawl.myapp.web.WebMain</mainClass>
              <targetDirectory>${project.build.directory}/js</targetDirectory>
              <targetFileName>classes.js</targetFileName>
              <minifying>true</minifying>
              <optimizationLevel>ADVANCED</optimizationLevel>
            </configuration>
          </execution>
          <execution>
            <!-- WebAssembly build: float math is real 32-bit like on Android, so app and browser
                 players simulate identically (cross-play). The JS build is the fallback. -->
            <id>wasm</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <mainClass>com.snakebrawl.myapp.web.WebMain</mainClass>
              <targetDirectory>${project.build.directory}/wasm</targetDirectory>
              <targetFileName>classes.wasm</targetFileName>
              <targetType>WEBASSEMBLY_GC</targetType>
              <minifying>true</minifying>
              <optimizationLevel>ADVANCED</optimizationLevel>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
